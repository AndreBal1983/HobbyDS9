/* Designer composes the accepted LCARS components and tokens. Scoped rules only. */
.ship-designer { flex-grow: 1; min-width: 0; min-height: 0; }
.ship-designer Label { white-space: normal; }
.sd-demo-banner { flex-shrink: 0; background-color: var(--lcars-amber); color: var(--lcars-canvas); padding: 6px 16px; -unity-font-style: bold; }
.sd-actions, .sd-buttons { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; }
.sd-actions { padding: 4px 0; }
.sd-actions .lcars-pill, .sd-buttons .lcars-pill { margin-right: var(--lcars-gap); margin-bottom: 4px; }
.sd-state { flex-grow: 1; min-width: 160px; font-size: 18px; }
.sd-columns { flex-direction: row; flex-grow: 1; min-height: 500px; min-width: 0; }
.sd-frame { min-height: 0; min-width: 0; margin-right: var(--lcars-gap); border-bottom-width: 3px; border-bottom-color: var(--lcars-amber); }
.sd-class-frame { width: 280px; }
.sd-centre-frame { flex-grow: 1; flex-shrink: 1; }
.sd-catalogue-frame { width: 440px; margin-right: 0; }
.sd-scroll { flex-grow: 1; min-height: 0; min-width: 0; padding: 8px 12px; }
.ship-designer .unity-base-field { flex-direction: column; align-items: stretch; margin-bottom: 12px; }
.ship-designer .unity-base-field__label { min-width: 0; margin-bottom: 4px; margin-right: 0; }
.ship-designer .unity-base-field__input { min-height: var(--lcars-button); background-color: var(--lcars-canvas); color: var(--lcars-text); border-width: 1px; border-color: var(--lcars-blue); }
.ship-designer .unity-base-popup-field__text { color: var(--lcars-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ship-designer .lcars-pill { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 16px; padding: 6px 12px; }
.ship-designer .lcars-readout { margin-bottom: 8px; font-size: 16px; }
.ship-designer .lcars-data-key { min-width: 100px; }
.ship-designer .lcars-data-row Label { font-size: 16px; }
.ship-designer .lcars-section-heading { font-size: 20px; }
.sd-installed-row { margin-bottom: 12px; border-top-width: 1px; border-top-color: var(--lcars-slate); padding-top: 8px; }
.sd-installed-row > .lcars-pill { align-self: stretch; }
.sd-selected { background-color: var(--lcars-lavender); border-color: var(--lcars-text); }
.sd-valid { color: var(--lcars-ready); }
.sd-warning { color: var(--lcars-sand); }
.sd-error { color: var(--lcars-alert); }
.sd-unavailable { color: var(--lcars-muted); }
.sd-preview-notice { padding: 8px; border-left-width: 4px; border-left-color: var(--lcars-lavender); }
.sd-catalogue-facts { color: var(--lcars-blue); }
.sd-schematic { height: 220px; min-height: 120px; flex-shrink: 0; background-color: var(--lcars-map); }
.sd-footer { height: 230px; min-height: 150px; flex-shrink: 0; border-top-width: var(--lcars-bar); border-top-color: var(--lcars-lavender); margin-top: var(--lcars-gap); }
#designer-profile-results { padding-top: 0; }
.sd-summary { flex-direction: row; }
.sd-metric-block { flex-grow: 1; flex-basis: 30%; margin-right: 16px; }
.sd-narrow .sd-columns { flex-wrap: wrap; height: 1040px; min-height: 1040px; flex-grow: 0; }
.sd-narrow .sd-class-frame { width: 34%; height: 400px; }
.sd-narrow .sd-centre-frame { width: 64%; flex-basis: 60%; height: 400px; }
.sd-narrow .sd-catalogue-frame { width: 100%; height: 640px; }
.sd-narrow .sd-footer { height: 250px; }
.sd-narrow .sd-summary { flex-direction: column; }
.sd-narrow .sd-metric-block { flex-basis: auto; flex-grow: 0; flex-shrink: 0; }
.sd-body { padding: 0; }

.sd-schematic Label { position: absolute; background-color: var(--lcars-canvas); color: var(--lcars-lavender); font-size: 14px; padding: 4px; }

.sd-catalogue-body { flex-grow: 1; min-height: 0; min-width: 0; padding: 8px 12px; }
#designer-catalogue-details { height: 110px; flex-shrink: 0; flex-grow: 0; padding: 0; }
#designer-installed-scroll { padding: 0; min-height: 120px; }
.sd-power-controls { flex-direction: row; } .sd-power-controls > .unity-base-field { flex-grow: 1; flex-basis: 45%; min-width: 0; margin-right: 8px; }
