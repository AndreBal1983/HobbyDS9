/* Focused designer pages compose existing LCARS tokens and controls. */
.ship-designer { flex-grow: 1; min-width: 0; min-height: 0; }
.ship-designer Label { white-space: normal; }
.sd-shell { flex-shrink: 0; padding: 4px 8px; border-bottom-width: 8px; border-bottom-color: var(--lcars-amber); }
.sd-identity { flex-direction: row; }
.sd-identity > .unity-base-field { flex-grow: 1; flex-basis: 30%; margin-right: 12px; }
.sd-buttons { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-items: center; }
.sd-buttons > .lcars-pill { margin-right: 8px; margin-bottom: 4px; }
.sd-actions > Label { margin-right: 20px; }
.sd-actions > .lcars-pill { min-width: 88px; }
.sd-body { flex-direction: row; flex-grow: 1; min-height: 0; padding-top: 8px; }
.sd-nav-scroll { width: 190px; flex-shrink: 0; margin-right: 12px; }
.sd-navigation > .lcars-pill { border-top-left-radius: 0; border-bottom-left-radius: 0; text-overflow: ellipsis; margin-bottom: 4px; min-height: 42px; }
.sd-workspace { flex-grow: 1; min-width: 0; min-height: 0; }
.sd-workspace > .lcars-section-heading { flex-shrink: 0; border-bottom-width: 3px; border-bottom-color: var(--lcars-lavender); padding-bottom: 6px; }
.sd-scroll { flex-grow: 1; min-height: 0; min-width: 0; padding: 6px 10px; }
.sd-focus-columns { flex-direction: row; flex-grow: 1; min-height: 0; min-width: 0; }
.sd-system-content { flex-grow: 1; min-width: 0; }
.sd-detail { width: 420px; max-width: 460px; flex-shrink: 0; border-left-width: 3px; border-left-color: var(--lcars-lavender); }
.sd-graphic { height: 210px; min-height: 160px; flex-shrink: 0; background-color: var(--lcars-map); border-top-width: 5px; border-bottom-width: 5px; border-top-color: var(--lcars-lavender); border-bottom-color: var(--lcars-amber); align-items: center; justify-content: center; margin-bottom: 12px; }
#designer-overview .sd-graphic { height: 360px; }
.sd-image { width: 100%; height: 100%; flex-grow: 1; }
.sd-placeholder-title { font-size: 32px; color: var(--lcars-lavender); margin-bottom: 16px; }
.sd-graphic > Label { color: var(--lcars-muted); }
.sd-summary { flex-direction: row; align-items: flex-start; }
.sd-summary > .sd-block { flex-grow: 1; flex-basis: 30%; margin-right: 16px; }
.sd-block { flex-shrink: 0; margin-bottom: 14px; }
.sd-component-row { flex-shrink: 0; margin-bottom: 10px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: var(--lcars-slate); }
.sd-component-row > .lcars-pill { align-self: stretch; }
.sd-profile-row .unity-base-field { flex-basis: 44%; flex-grow: 1; margin-right: 16px; }
.ship-designer .unity-base-field { flex-direction: column; align-items: stretch; margin-bottom: 6px; }
.ship-designer .unity-base-field__label { min-width: 0; margin-bottom: 2px; }
.ship-designer .unity-base-field__input { min-height: 38px; background-color: var(--lcars-canvas); color: var(--lcars-text); border-width: 1px; border-color: var(--lcars-blue); }
.ship-designer .unity-base-popup-field__text { color: var(--lcars-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ship-designer .lcars-pill { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 16px; padding: 6px 12px; min-height: 42px; }
.ship-designer .lcars-readout { font-size: 16px; margin-bottom: 6px; }
.ship-designer .lcars-data-row Label { font-size: 16px; }
.ship-designer .lcars-data-key { min-width: 125px; }
.ship-designer .lcars-section-heading { font-size: 20px; }
.sd-selected { background-color: var(--lcars-lavender); border-color: var(--lcars-text); }
.sd-valid { color: var(--lcars-ready); }
.sd-warning { color: var(--lcars-sand); }
.sd-error { color: var(--lcars-alert); }
.sd-unavailable { color: var(--lcars-muted); }
.sd-provenance { flex-shrink: 0; border-top-width: 3px; border-top-color: var(--lcars-amber); padding-top: 4px; }
.sd-provenance .lcars-readout { flex-grow: 1; }
.sd-provenance .lcars-pill { font-size: 14px; }
.sd-narrow .sd-nav-scroll { width: auto; height: 100px; margin-bottom: 8px; margin-right: 0; }
.sd-narrow .sd-navigation { flex-direction: row; flex-wrap: wrap; }
.sd-narrow .sd-navigation > .lcars-pill { width: 160px; margin-right: 5px; font-size: 14px; }
.sd-narrow .sd-body { flex-direction: column; }
.sd-narrow .sd-detail { width: 340px; }
.sd-narrow .sd-graphic { height: 160px; }
.sd-narrow #designer-overview .sd-graphic { height: 240px; }
.sd-narrow .sd-summary { flex-wrap: wrap; }
.sd-narrow .sd-actions > Label { font-size: 14px; margin-right: 12px; }
.sd-wide #designer-overview .sd-graphic { height: 430px; }
.sd-wide .sd-detail { width: 460px; }
.sd-system-picker { display: none; }
.sd-overview-stage { flex-direction: row; align-items: flex-start; }
.sd-overview-art { flex-grow: 1; min-width: 0; margin-right: 20px; }
.sd-overview-facts { width: 380px; flex-shrink: 0; }
#designer-overview .sd-graphic { height: 420px; }
.sd-wide #designer-overview .sd-graphic { height: 500px; }
.sd-narrow .sd-nav-scroll { display: none; }
.sd-narrow .sd-system-picker { display: flex; flex-shrink: 0; margin: 0 8px 6px 8px; }
.sd-narrow .sd-system-picker > .unity-base-field__label { display: none; }
.sd-narrow .sd-identity > .unity-base-field > .unity-base-field__label { display: none; }
.sd-narrow .sd-overview-stage { flex-direction: column; }
.sd-narrow .sd-overview-art { width: 100%; margin-right: 0; }
.sd-narrow #designer-overview .sd-graphic { height: 210px; }
.sd-narrow .sd-overview-facts { width: 100%; }
.sd-narrow .sd-overview-facts .lcars-inspector-block { margin-bottom: 8px; }
.sd-narrow .sd-graphic { height: 130px; min-height: 110px; }
.sd-narrow .sd-provenance .lcars-readout { display: none; }
.sd-narrow .sd-provenance .lcars-pill { min-height: 28px; }
/* Scoped outer-shell compaction applies only while designing, never to the map. */
.designer-open.layout-compact .lcars-header-controls { display: none; }
.designer-open.layout-compact .lcars-nav-segment { width: 110px; font-size: 14px; min-height: 38px; }
.designer-open.layout-compact .lcars-header { min-height: 100px; }
