/* Strategic view styles. Shared sizes/colors are supplied by LcarsTokens.uss. */
.details-panel, .production-panel {
    padding: var(--lcars-padding); min-height: 0;
    background-color: var(--lcars-panel); color: var(--lcars-text);
}
.details-panel Label, .production-panel Label, .combat-text {
    white-space: normal; margin-bottom: var(--lcars-inner-gap);
}
.details-panel Button, .production-panel Button, .lcars-header Button {
    min-height: var(--lcars-button); white-space: normal;
    margin-top: 4px; margin-bottom: var(--lcars-gap);
    padding: 8px 16px; border-radius: 22px;
    background-color: var(--lcars-blue); border-width: 2px; border-color: var(--lcars-blue);
    color: var(--lcars-canvas); -unity-font-style: bold;
}
.details-panel Button:hover, .production-panel Button:hover { background-color: var(--lcars-sand); }
.details-panel Button:focus, .production-panel Button:focus { border-color: var(--lcars-text); }
.details-panel Button:disabled, .production-panel Button:disabled {
    opacity: 1; background-color: var(--lcars-slate); border-color: var(--lcars-slate); color: var(--lcars-text);
}
.details-panel .lcars-destructive, .production-panel .lcars-destructive {
    background-color: var(--lcars-alert); border-color: var(--lcars-alert);
}
.confirmation {
    padding: var(--lcars-padding); margin-top: var(--lcars-inner-gap); margin-bottom: var(--lcars-inner-gap);
    border-width: 2px; border-color: var(--lcars-alert); background-color: var(--lcars-panel);
}
/* Every input gets its own readable row; long dropdown choices fit the sidebar. */
.details-panel .unity-base-field, .production-panel .unity-base-field, .combat-plan-field {
    flex-direction: column; align-items: stretch; min-width: 0;
    margin-bottom: var(--lcars-inner-gap); margin-left: 0; margin-right: 0;
}
.details-panel .unity-base-field__label, .production-panel .unity-base-field__label {
    min-width: 0; margin-right: 0; margin-bottom: 4px; white-space: normal; flex-shrink: 0;
}
.details-panel .unity-base-field__input, .production-panel .unity-base-field__input {
    width: 100%; min-width: 0; min-height: var(--lcars-button); flex-grow: 1;
    color: var(--lcars-text); background-color: var(--lcars-canvas);
    border-width: 1px; border-color: var(--lcars-slate);
}
.details-panel .unity-base-popup-field__text { white-space: normal; color: var(--lcars-text); }
.details-panel .unity-base-field:focus > .unity-base-field__input { border-color: var(--lcars-text); }
.details-panel .unity-base-field:disabled, .production-panel .unity-base-field:disabled { opacity: 0.8; }
.details-panel .unity-foldout__text, .production-panel .unity-foldout__text { white-space: normal; }
.details-panel .unity-foldout, .production-panel .unity-foldout { margin-top: var(--lcars-gap); margin-bottom: var(--lcars-gap); }
.production-world, .battle-report {
    margin-top: var(--lcars-inner-gap); margin-bottom: var(--lcars-inner-gap);
    border-top-width: 2px; border-top-color: var(--lcars-slate); padding-top: var(--lcars-gap);
}
.combat-heading { color: var(--lcars-sand); font-size: var(--lcars-heading-size); -unity-font-style: bold; white-space: normal; }
.combat-ai-participant { border-left-width: 3px; border-left-color: var(--lcars-slate); padding-left: var(--lcars-inner-gap); }
.combat-human-participant { border-left-width: 3px; border-left-color: var(--lcars-sand); padding-left: var(--lcars-inner-gap); }
.battle-report { border-top-color: var(--lcars-lavender); }
.lcars-alert { color: var(--lcars-alert); }
.combat-attention .lcars-primary-status { color: var(--lcars-sand); }
.map-marker:hover, .map-marker:focus { border-width: 2px; }
.details-panel Label, .production-panel Label, .details-panel Button, .production-panel Button,
.details-panel .unity-base-field__input, .production-panel .unity-base-field__input { font-size: var(--lcars-text-size); }
.details-panel .lcars-section-heading, .production-panel .lcars-section-heading, .details-panel .combat-heading { font-size: var(--lcars-heading-size); }
.message-bar.lcars-alert { color: var(--lcars-alert); }
