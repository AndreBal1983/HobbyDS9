.client-root {
    flex-grow: 1;
    background-color: rgb(6, 10, 17);
    color: rgb(230, 237, 245);
    font-size: 17px;
}
.top-bar {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 12px 16px;
}
.campaign-status {
    flex-grow: 1;
    margin-left: 24px;
}
.workspace {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.details-panel {
    width: 25%;
    min-width: 320px;
    max-width: 520px;
    flex-shrink: 0;
    padding: 16px;
    background-color: rgb(15, 23, 33);
}
.message-bar {
    white-space: normal;
    padding: 8px 16px;
}
.details-panel Button {
    min-height: 32px;
    margin-top: 6px;
    margin-bottom: 6px;
    white-space: normal;
}
.top-bar Button {
    min-height: 32px;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
}

/* Stack labels above full-width inputs so long choices fit the bounded sidebar. */
.combat-plan-field {
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    margin-bottom: 8px;
}
.combat-plan-field > .unity-base-field__label {
    min-width: 0;
    margin-right: 0;
    margin-bottom: 4px;
    white-space: normal;
    flex-shrink: 0;
}
.combat-plan-field > .unity-base-field__input {
    width: 100%;
    min-width: 0;
    min-height: 30px;
    flex-grow: 1;
}

.strategic-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 16px 8px;
}
.strategic-tabs Button {
    min-height: 32px;
    padding: 4px 18px;
    margin-right: 8px;
}
.active-tab {
    background-color: rgb(35, 76, 105);
    color: white;
}
Button:hover { border-color: rgb(143, 196, 225); }
Button:disabled { opacity: 0.5; }
.map-marker:hover { border-width: 2px; }
.campaign-status { white-space: normal; }
.confirmation {
    margin-top: 12px;
    padding: 12px;
    border-width: 1px;
    border-color: rgb(232, 191, 99);
    background-color: rgb(34, 35, 40);
}

/* Independent scrollable production dock; the center map retains flex space. */
.production-panel {
    width: 20%;
    min-width: 300px;
    max-width: 440px;
    min-height: 0;
    flex-shrink: 0;
    padding: 12px;
    background-color: rgb(15, 23, 33);
}
.production-panel Label { white-space: normal; margin-bottom: 8px; }
.production-panel Button { min-height: 32px; white-space: normal; margin-bottom: 8px; }
.production-world { margin-top: 12px; margin-bottom: 12px; }
.production-panel .unity-foldout__text { white-space: normal; }
#production-heading { font-size: 23px; -unity-font-style: bold; }

.combat-text, .combat-heading { white-space: normal; margin-bottom: 12px; }
.combat-heading { font-size: 23px; -unity-font-style: bold; }
.battle-report { margin-top: 16px; }
.battle-report .unity-foldout__text { white-space: normal; }
