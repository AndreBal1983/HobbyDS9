/* Reusable console components. Palette/type/spacing are defined in LcarsTokens. */
.client-root { background-color: var(--lcars-canvas); color: var(--lcars-text); font-size: var(--lcars-text-size); }
.lcars-pill {
    min-height: var(--lcars-button); border-radius: 22px;
    padding: 8px 18px; background-color: var(--lcars-blue); color: var(--lcars-canvas);
    border-width: 2px; border-color: var(--lcars-blue); -unity-font-style: bold;
    white-space: nowrap;
}
.lcars-pill:hover, .lcars-nav-segment:hover { background-color: var(--lcars-sand); }
.lcars-pill:focus, .lcars-nav-segment:focus { border-color: var(--lcars-text); }
.lcars-pill:disabled, .lcars-nav-segment:disabled {
    opacity: 1; background-color: var(--lcars-slate); border-color: var(--lcars-slate); color: var(--lcars-text);
}
.lcars-primary-action { background-color: var(--lcars-sand); border-color: var(--lcars-sand); }
.lcars-section-heading {
    font-size: var(--lcars-heading-size); -unity-font-style: bold; color: var(--lcars-sand);
    white-space: normal; margin-top: var(--lcars-inner-gap); margin-bottom: var(--lcars-inner-gap);
}
.lcars-readout { white-space: normal; }
.lcars-diagnostic { color: var(--lcars-muted); font-size: 16px; }
.lcars-panel-frame { background-color: var(--lcars-panel); min-height: 0; flex-shrink: 0; }
.lcars-panel-title {
    color: var(--lcars-canvas); background-color: var(--lcars-lavender); font-size: var(--lcars-text-size);
    padding: 6px 16px; margin: 0 0 8px 0; min-height: var(--lcars-bar);
    border-top-right-radius: 24px;
}
.lcars-nav-segment {
    min-height: var(--lcars-nav-height); flex-shrink: 0; margin: 0 0 var(--lcars-gap) 0;
    background-color: var(--lcars-amber); color: var(--lcars-canvas); border-width: 2px; border-color: var(--lcars-amber);
    border-top-left-radius: 24px; border-bottom-left-radius: 24px;
    padding: 8px; white-space: nowrap; -unity-font-style: bold;
}
.lcars-nav-segment.active-tab { background-color: var(--lcars-lavender); border-color: var(--lcars-text); }
.lcars-nav-segment.production-open { background-color: var(--lcars-sand); }
.lcars-elbow { color: var(--lcars-amber); flex-shrink: 0; }

/* Shell uses bounded furniture and gives all surplus width to the map. */
.lcars-shell { flex-grow: 1; min-height: 0; min-width: 0; padding: 8px; }
.lcars-header { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 104px; }
.lcars-title {
    background-color: var(--lcars-sand); color: var(--lcars-canvas); -unity-font-style: bold;
    font-size: var(--lcars-heading-size); width: 136px; padding: 12px; margin-right: var(--lcars-gap);
    border-top-left-radius: 48px; white-space: normal; flex-shrink: 0;
}
.lcars-header-readouts { flex-grow: 1; min-width: 0; padding: 8px 16px; }
.lcars-primary-status { font-size: var(--lcars-heading-size); -unity-font-style: bold; }
.lcars-secondary-status { color: var(--lcars-lavender); margin-top: 4px; }
.lcars-header-controls { flex-direction: row; flex-shrink: 0; }
.lcars-header-controls Button { min-width: 132px; max-width: 180px; margin-left: var(--lcars-gap); }
#toggle-details { margin-left: var(--lcars-gap); }
.lcars-frame-bar { height: 64px; flex-direction: row; flex-shrink: 0; }
.lcars-structural-bar {
    background-color: var(--lcars-amber); color: var(--lcars-canvas); height: var(--lcars-bar);
    flex-grow: 1; padding: 4px 16px; -unity-font-style: bold; border-top-right-radius: 24px;
}
.lcars-body { flex-direction: row; flex-grow: 1; min-height: 0; min-width: 0; }
.lcars-navigation { flex-shrink: 0; margin-right: var(--lcars-gap); }
.lcars-workspace { flex-direction: row; flex-grow: 1; min-width: 0; min-height: 0; position: relative; }
.lcars-map-frame { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; margin-right: var(--lcars-gap); }
#details-frame { margin-left: 0; }
#production-frame { margin-right: var(--lcars-gap); }
.lcars-drawer { border-right-width: 4px; border-right-color: var(--lcars-sand); }
.lcars-context-drawer { position: absolute; right: 0; top: 0; bottom: 0; border-left-width: 4px; border-left-color: var(--lcars-lavender); }
.layout-compact .lcars-body { flex-direction: column; }
.layout-compact .lcars-navigation { flex-direction: row; flex-wrap: wrap; margin-right: 0; margin-bottom: var(--lcars-gap); }
.layout-compact .lcars-nav-segment { width: 132px; margin-right: var(--lcars-gap); }
.layout-compact .lcars-frame-bar { height: 8px; }
.layout-compact .lcars-elbow, .layout-compact .lcars-structural-bar { display: none; }
.layout-compact .lcars-title { width: 104px; font-size: 22px; }
.layout-compact .lcars-header { flex-wrap: wrap; }
.layout-compact .lcars-header-readouts { flex-basis: 55%; }
.layout-compact .lcars-primary-status { font-size: 20px; }
.layout-compact .lcars-header-controls { flex-grow: 1; justify-content: flex-end; }
.layout-compact .lcars-header-controls Button { min-width: 124px; }
#details-frame > .details-panel, #production-frame > .production-panel {
    width: 100%; min-width: 0; max-width: 100%; flex-grow: 1; min-height: 0;
    background-color: var(--lcars-panel);
}
.message-bar { color: var(--lcars-muted); background-color: var(--lcars-panel); padding: 8px 16px; white-space: normal; min-height: 40px; }
.lcars-header .lcars-primary-action { background-color: var(--lcars-sand); border-color: var(--lcars-sand); }
.lcars-header .lcars-primary-action:disabled { background-color: var(--lcars-slate); border-color: var(--lcars-slate); color: var(--lcars-text); }
.lcars-pill, .lcars-nav-segment { font-size: var(--lcars-text-size); }
.lcars-pill:focus, .lcars-nav-segment:focus { border-width: 3px; border-color: var(--lcars-text); }
.lcars-nav-segment.active-tab:hover { background-color: var(--lcars-sand); }

/* Strategic prototype: extends the existing shell, not an alternate UI stack. */
.strategic-prototype .lcars-header { min-height: var(--lcars-header-height); }
.strategic-prototype .lcars-title { width: var(--lcars-rail-width); font-size: 20px; padding: 16px; border-top-left-radius: 40px; }
.strategic-prototype .lcars-frame-bar { height: var(--lcars-frame-height); }
.strategic-prototype .lcars-navigation { background-color: var(--lcars-amber); border-bottom-left-radius: 40px; padding-bottom: 24px; }
.strategic-prototype .lcars-nav-segment { border-radius: 0; border-top-width: 0; border-bottom-width: 0; margin-bottom: 6px; }
.strategic-prototype .lcars-nav-segment.active-tab { border-left-width: 6px; }
.lcars-rail-tail { flex-grow: 1; color: var(--lcars-canvas); -unity-font-style: bold; font-size: var(--lcars-small-size); -unity-text-align: lower-right; padding: 16px; }
.lcars-compact-readout { min-width: 100px; margin-right: 16px; padding: 8px 16px; border-left-width: 4px; border-left-color: var(--lcars-blue); flex-shrink: 0; }
.lcars-compact-readout .lcars-readout { font-size: var(--lcars-heading-size); -unity-font-style: bold; white-space: nowrap; }
.lcars-readout-key { font-size: var(--lcars-small-size); color: var(--lcars-blue); }
.lcars-data-row { flex-direction: row; align-items: center; min-height: var(--lcars-row-height); border-bottom-width: 1px; border-bottom-color: var(--lcars-slate); }
.details-panel .lcars-data-row Label { margin-bottom: 0; font-size: 16px; }
.lcars-data-key { min-width: 120px; flex-grow: 1; flex-shrink: 0; color: var(--lcars-muted); padding-right: 8px; }
.lcars-data-value { flex-shrink: 1; -unity-text-align: middle-right; color: var(--lcars-text); }
.lcars-inspector-block { padding-bottom: var(--lcars-inner-gap); }
.lcars-inspector-block .lcars-section-heading { font-size: 20px; margin-top: 4px; margin-bottom: 8px; }
.lcars-meter { margin-top: 4px; margin-bottom: 4px; }
.lcars-meter-track { height: 4px; background-color: var(--lcars-slate); }
.lcars-meter-fill { height: 4px; background-color: var(--lcars-lavender); }
.details-panel .lcars-order-quote, .details-panel .lcars-order-reason { font-size: 16px; margin-bottom: 4px; }
.lcars-warning { color: var(--lcars-sand); border-left-width: 3px; border-left-color: var(--lcars-amber); padding-left: 8px; }
.strategic-prototype .details-panel .lcars-pill, .strategic-prototype .production-panel .lcars-pill { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-radius: var(--lcars-radius); }
.lcars-map-legend { position: absolute; left: var(--lcars-map-inset); bottom: var(--lcars-map-inset); font-size: var(--lcars-small-size); color: var(--lcars-muted); background-color: var(--lcars-canvas); padding: 8px 12px; }
.lcars-activity { flex-direction: row; min-height: var(--lcars-activity-height); flex-shrink: 0; margin-top: var(--lcars-gap); border-bottom-left-radius: 28px; background-color: var(--lcars-panel); }
.lcars-activity-title { width: var(--lcars-rail-width); background-color: var(--lcars-amber); color: var(--lcars-canvas); -unity-font-style: bold; -unity-text-align: middle-right; padding-right: 16px; border-bottom-left-radius: 28px; }
.lcars-activity .message-bar { flex-grow: 1; min-width: 0; -unity-text-align: middle-left; }
.strategic-prototype.layout-compact .lcars-navigation { padding-bottom: 0; background-color: var(--lcars-canvas); border-radius: 0; }
.strategic-prototype.layout-compact .lcars-rail-tail { display: none; }
.strategic-prototype.layout-compact .lcars-nav-segment { width: var(--lcars-rail-width); }
.strategic-prototype.layout-compact .lcars-frame-bar { height: 8px; }
.strategic-prototype.layout-compact .lcars-compact-readout { min-width: 80px; margin-right: 8px; }
.strategic-prototype.layout-compact .lcars-activity-title { width: 120px; }

.galaxy-map { background-color: var(--lcars-map); }
.strategic-prototype .map-marker { font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-radius: 8px; }

.strategic-prototype .map-selected { border-width: 2px; border-color: var(--lcars-sand); }
