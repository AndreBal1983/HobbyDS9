/* Original HobbyDS9 console tokens. All sizes are reference-panel logical units. */
.client-root {
    --lcars-canvas: #05070A;
    --lcars-panel: #0B1018;
    --lcars-map: #070B10;
    --lcars-amber: #D99552;
    --lcars-sand: #E2BC7C;
    --lcars-peach: #C98872;
    --lcars-lavender: #A58BC4;
    --lcars-blue: #6997B8;
    --lcars-slate: #496979;
    --lcars-alert: #C7605B;
    --lcars-ready: #7FAF9B;
    --lcars-text: #F1E8D8;
    --lcars-muted: #A9B0BA;
    --lcars-bar: 30px;
    --lcars-button: 44px;
    --lcars-nav-height: 50px;
    --lcars-rail-width: 180px;
    --lcars-gap: 8px;
    --lcars-padding: 16px;
    --lcars-inner-gap: 8px;
    --lcars-text-size: 18px;
    --lcars-heading-size: 24px;
    --lcars-small-size: 14px;
    --lcars-row-height: 28px;
    --lcars-radius: 22px;
    --lcars-header-height: 96px;
    --lcars-map-inset: 16px;
    --lcars-frame-height: 48px;
    --lcars-activity-height: 44px;
}
