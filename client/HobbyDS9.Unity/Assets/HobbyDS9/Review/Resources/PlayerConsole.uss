.player-console { flex-grow: 1; min-height: 0; padding: 14px 24px 14px 40px; color: #eeeaf2; background-color: #050a10; font-size: 18px; }
.player-console .review-action { min-height: 44px; padding: 8px 16px; margin: 3px; border-width: 1px; border-radius: 6px; border-color: #65798e; background-color: #15202d; color: #eeeaf2; font-size: 18px; }
.player-console .review-action:disabled { background-color: #18212b; color: #a8b3c4; border-color: #38485a; }
.player-console .review-action:focus { border-color: #f5f0dd; border-width: 2px; }
.player-console .primary-action { background-color: #efb16b; color: #0a1019; border-color: #efb16b; -unity-font-style: bold; min-width: 210px; }
.console-spine { position: absolute; left: 8px; top: 16px; bottom: 16px; width: 20px; border-top-left-radius: 22px; border-bottom-left-radius: 22px; background-color: #efb16b; }
.console-header { flex-direction: row; justify-content: space-between; flex-shrink: 0; min-height: 72px; border-bottom-width: 3px; border-bottom-color: #efb16b; margin-bottom: 8px; }
.console-title { font-size: 28px; -unity-font-style: bold; color: #eeeaf2; margin-bottom: 8px; }
.console-kicker { color: #efb16b; font-size: 16px; }
.console-status { color: #9fd8fb; font-size: 18px; white-space: normal; -unity-text-align: middle-right; }
.console-guidance { min-height: 30px; flex-shrink: 0; color: #efb16b; font-size: 16px; white-space: normal; margin-bottom: 8px; }
.console-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.console-nav { width: 170px; flex-shrink: 0; padding-right: 14px; }
.console-nav .review-action { -unity-text-align: middle-left; margin-bottom: 8px; }
.console-nav .selected-nav { border-left-width: 5px; border-left-color: #efb16b; background-color: #2a2c34; color: #ffe0b9; }
.console-main { flex-grow: 1; min-width: 0; min-height: 0; max-width: 2500px; }
.player-console .review-central { margin: 0; padding: 10px; border-color: #52616e; border-radius: 12px; }
.player-console .review-heading { font-size: 22px; color: #b9ace6; }
.player-console .review-panel, .console-panel { background-color: #0d1621; border-width: 1px; border-color: #415365; border-radius: 10px; padding: 18px; min-width: 0; min-height: 0; margin: 5px; }
.console-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.console-work { flex-grow: 1; min-width: 0; min-height: 0; }
.console-aside { width: 320px; flex-shrink: 0; min-height: 0; }
.console-section { color: #b9ace6; font-size: 22px; -unity-font-style: bold; margin-bottom: 12px; white-space: normal; }
.console-intro { font-size: 22px; color: #ffe0b9; margin: 8px 0 16px 0; white-space: normal; }
.console-copy { white-space: normal; color: #c3d4e7; margin: 3px 0 8px 0; }
.console-metric { font-size: 25px; color: #ffe0b9; margin-bottom: 8px; white-space: normal; }
.science-grid { flex-direction: row; flex-wrap: wrap; flex-grow: 1; min-height: 0; }
.science-card { width: 31%; flex-grow: 1; margin: 6px; padding: 14px; border-width: 1px; border-color: #456079; border-radius: 8px; background-color: #111e2b; min-height: 180px; }
.science-card .console-section { font-size: 18px; margin-bottom: 6px; }
.science-card .console-copy { font-size: 16px; margin-bottom: 3px; }
.science-card .console-metric { font-size: 23px; margin-bottom: 4px; }
.science-card .review-action { min-height: 36px; padding: 4px 8px; font-size: 16px; }
.science-card Foldout { font-size: 16px; }
.console-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 8px; }
.console-tabs .selected-tab { background-color: #3f3548; border-bottom-color: #efb16b; border-bottom-width: 3px; }
.console-queue { margin: 8px 0; padding: 14px; border-width: 1px; border-color: #8c6948; border-left-width: 4px; border-radius: 8px; background-color: #111d29; }
.console-footer { flex-direction: row; flex-wrap: wrap; justify-content: space-between; flex-shrink: 0; min-height: 58px; border-top-width: 3px; border-top-color: #efb16b; padding-top: 8px; margin-top: 8px; }
.console-footer-note { color: #c3d4e7; white-space: normal; font-size: 16px; }
.player-console .review-confirmation { padding: 24px; border-width: 2px; border-color: #efb16b; margin: 60px 100px; }
.player-console Slider { min-height: 60px; margin: 16px; }
.player-console Toggle { min-height: 42px; margin: 8px; }
.player-console .unity-progress-bar { min-height: 8px; margin: 6px 0; }
.player-console .unity-progress-bar__background { background-color: #263443; }
.player-console .unity-progress-bar__progress { background-color: #9fd8fb; }
.player-console .unity-progress-bar__title { display: none; }
.player-console .unity-base-field { font-size: 18px; min-height: 38px; white-space: normal; }
.player-console .unity-base-field__label { min-width: 0; }
.player-console .unity-base-popup-field__input { background-color: #182431; color: #eeeaf2; border-width: 1px; border-color: #65798e; min-height: 40px; }
.player-narrow { padding: 8px 12px 8px 28px; }
.player-narrow .console-spine { width: 12px; left: 4px; }
.player-narrow .console-nav { width: 144px; padding-right: 6px; }
.player-narrow .console-nav .review-action { font-size: 16px; min-height: 40px; padding: 6px 8px; margin-bottom: 5px; }
.player-narrow .console-header { min-height: 58px; }
.player-narrow .console-title { font-size: 24px; margin-bottom: 4px; }
.player-narrow .console-guidance { font-size: 16px; margin-bottom: 4px; }
.player-narrow .console-aside { width: 248px; }
.player-narrow .console-panel { padding: 10px; margin: 3px; }
.player-narrow .science-card { width: 45%; min-height: 118px; margin: 3px; padding: 8px; }
.player-narrow .science-card .console-section { font-size: 16px; }
.player-narrow .science-card .console-metric { font-size: 18px; }
.player-narrow .science-card .review-action { min-height: 30px; font-size: 16px; padding: 2px 8px; }
.player-narrow .console-intro { font-size: 20px; margin: 4px 0 8px 0; }
.player-narrow .console-footer { min-height: 50px; margin-top: 4px; padding-top: 4px; }
.player-narrow .primary-action { min-width: 170px; }
.player-narrow .science-grid { flex-direction: column; flex-wrap: nowrap; }
.player-narrow .science-compact-row { width: auto; min-height: 44px; max-height: 44px; padding: 4px 8px; flex-direction: row; align-items: center; flex-shrink: 0; }
.player-narrow .science-compact-row Label { margin: 0; padding: 0; min-height: 0; }
.player-narrow .science-compact-row .console-copy { font-size: 14px; }
.player-narrow .science-compact-row .review-action { min-width: 36px; margin: 2px; padding: 3px 6px; }
.player-console .science-card ProgressBar { height: 8px; min-height: 8px; max-height: 8px; }
.player-console .science-card .unity-progress-bar__container { height: 8px; min-height: 8px; }
.player-console ScrollView .unity-scroller--vertical { width: 12px; }
.player-console .unity-scroller { background-color: #142131; }
.player-console .unity-scroller .unity-slider__tracker { background-color: #142131; }
.player-console .unity-scroller .unity-slider__dragger { background-color: #607995; border-width: 0; }
.player-console .unity-scroller .unity-base-slider__tracker { background-color: #142131; }
.player-console .unity-scroller .unity-base-slider__dragger { background-color: #607995; border-width: 0; }
.player-narrow .review-roster { width: 220px; }
.player-narrow .review-order-dock { width: 280px; }
.player-narrow .review-schematic-scroll { max-height: 110px; }
.player-narrow .review-detail-scroll { min-height: 120px; }
.demo-combat .review-input { min-width: 0; }
/* Keep the order dock within its own viewport; wrap content, never pan to read. */
.demo-combat .combat-order-content { width: 100%; min-width: 0; max-width: 100%; align-items: stretch; }
.demo-combat .review-order-dock .review-field-row { flex-direction: column; flex-wrap: nowrap; min-width: 0; max-width: 100%; align-items: stretch; }
.demo-combat .review-order-dock .review-action { min-width: 0; max-width: 100%; align-self: stretch; white-space: normal; flex-shrink: 0; }
.demo-combat .review-order-dock .unity-base-field { min-width: 0; max-width: 100%; flex-direction: column; align-self: stretch; flex-shrink: 0; }
.demo-combat .review-order-dock .unity-base-field__label, .demo-combat .review-order-dock Label { min-width: 0; max-width: 100%; white-space: normal; }
.demo-combat .review-order-dock .unity-base-field__input { min-width: 0; }
.demo-combat .review-order-dock .unity-base-popup-field__text { min-width: 0; white-space: normal; flex-shrink: 1; }
.demo-combat .review-footer .review-action { min-width: 0; max-width: 100%; white-space: normal; flex-basis: 240px; flex-grow: 1; flex-shrink: 1; }
.player-narrow .demo-combat .review-roster { width: 260px; }
.player-narrow .demo-combat .review-order-dock { width: 248px; }
.player-narrow .demo-combat .review-tabs .review-action { min-width: 0; padding: 3px 6px; font-size: 16px; }
.player-narrow .demo-combat .combat-current-stocks { font-size: 16px; }
.player-narrow .demo-combat .review-detail-scroll { min-height: 0; }
.player-narrow .demo-combat .combat-context-copy { display: none; }
.player-narrow .demo-combat .unity-base-popup-field__text { font-size: 16px; }
.demo-combat .review-stage-row, .demo-combat .review-viewer { overflow: hidden; }
.player-narrow .demo-combat .review-schematic-scroll { height: 60px; max-height: 60px; min-height: 40px; flex-grow: 0; }

/* Owner-directed Science allocation bank: all six drafts share one fixed budget. */
.science-allocation-bank { flex-direction: column; flex-shrink: 0; border-top-width: 6px; border-top-color: #b9ace6; padding-top: 8px; }
.science-allocation-row { flex-direction: row; align-items: center; min-height: 64px; flex-shrink: 0; }
.science-allocation-label { width: 148px; flex-shrink: 0; }
.science-allocation-label .review-action { border-width: 0; background-color: transparent; margin: 0; padding: 0; min-height: 30px; -unity-text-align: middle-left; -unity-font-style: bold; }
.science-allocation-level { color: #a9b8c8; font-size: 14px; }
.science-allocation-track { height: 44px; min-width: 120px; flex-grow: 1; border-width: 2px; border-color: transparent; border-top-left-radius: 20px; border-bottom-left-radius: 20px; overflow: hidden; }
.science-allocation-track:focus { border-color: #9fd8fb; }
.science-allocation-exact { width: 68px; flex-shrink: 0; align-items: center; }
.science-allocation-percent { font-size: 22px; color: #efb16b; }
.science-allocation-lock { width: 78px; min-width: 0; flex-shrink: 0; }
.science-allocation-steps { flex-direction: row; flex-shrink: 0; }
.science-allocation-steps .review-action { min-width: 28px; min-height: 38px; padding: 1px 5px; margin: 1px; }
.player-narrow .science-allocation-label { width: 112px; }
.player-narrow .science-allocation-label .review-action { font-size: 16px; }
.player-narrow .science-allocation-row { min-height: 54px; }
.player-narrow .science-allocation-track { min-width: 100px; height: 40px; }
.player-narrow .science-allocation-exact { width: 52px; }
.player-narrow .science-allocation-percent { font-size: 20px; }
.player-narrow .science-allocation-lock { width: 64px; padding: 4px; font-size: 16px; }
.player-narrow .science-allocation-steps .review-action { min-width: 24px; padding: 1px 4px; font-size: 16px; }
.playable-map { flex-grow: 1; min-height: 300px; overflow: hidden; background-color: #050a10; border-width: 1px; border-color: #243449; }
.map-star { margin: 0; padding: 0; border-radius: 19px; border-width: 2px; border-color: transparent; background-color: #0b1824; color: #9fd8fb; font-size: 30px; -unity-text-align: middle-center; }
.map-fleet-ring { margin: 0; padding: 0; border-radius: 38px; border-width: 6px; border-color: #efb16b; background-color: transparent; }
.map-contact { margin: 0; padding: 0; border-radius: 4px; border-width: 1px; border-color: transparent; background-color: #0b1824; color: #efb16b; font-size: 36px; -unity-text-align: middle-center; }
.map-star:focus, .map-fleet-ring:focus, .map-contact:focus { border-color: #9fd8fb; }
.map-star:hover, .map-contact:hover { background-color: #243449; }
.playable-map-aside .review-action, .fleet-roster-aside .review-action { min-width: 0; max-width: 100%; white-space: normal; flex-shrink: 0; align-self: stretch; }
.fleet-roster-aside .unity-base-field { flex-direction: column; min-width: 0; max-width: 100%; flex-shrink: 0; align-self: stretch; }
.selected-map-marker { border-color: #eeeaf2; }
.map-node-name { color: #eeeaf2; font-size: 18px; -unity-text-align: middle-left; }
.map-own-count { color: #efb16b; font-size: 15px; -unity-text-align: middle-center; }
.world-ledger-table { min-width: 2584px; flex-shrink: 0; }
.world-ledger-row { flex-direction: row; flex-shrink: 0; min-height: 52px; border-bottom-width: 1px; border-bottom-color: #243449; }
.world-ledger-cell { width: 152px; min-width: 152px; padding: 4px 8px; justify-content: center; }
.world-ledger-cell .review-action { margin: 0; padding: 5px; min-width: 0; white-space: normal; font-size: 16px; }
.world-ledger-cell Label { font-size: 16px; white-space: normal; }
.world-ledger-filter { min-width: 0; margin-top: 4px; }
.world-row-selected { background-color: #2a2c34; border-left-width: 4px; border-left-color: #efb16b; }
.world-system-heading { -unity-text-align: middle-left; background-color: #172637; }
.player-console .unity-scroller .unity-scroller__low-button, .player-console .unity-scroller .unity-scroller__high-button { background-color: #263b52; -unity-background-image-tint-color: #c3d4e7; }
.player-console .lcars-pill { background-image: none; background-color: #9fd8fb; color: #050a10; }
.player-console .lcars-pill:disabled { background-image: none; background-color: #334456; color: #c3d4e7; }

.battle-presentation { flex-shrink: 0; margin-bottom: 8px; }
.battle-viewport { height: 280px; min-height: 140px; flex-shrink: 1; background-color: rgb(3, 6, 11); }
.battle-presentation Label { white-space: normal; }
.player-narrow .battle-viewport { height: 140px; min-height: 100px; }
.player-narrow .battle-presentation Label { font-size: 14px; }
