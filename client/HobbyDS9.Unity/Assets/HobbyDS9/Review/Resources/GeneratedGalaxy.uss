.galaxy-root {
    flex-grow: 1; min-height: 0; padding: 22px;
    background-color: #050a10; color: #eeeaf2; font-size: 17px;
}
.galaxy-header { flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0; }
.galaxy-root .review-action { min-height: 44px; padding: 7px 12px; border-width: 1px; border-radius: 6px; border-color: #607993; background-color: #172637; color: #eeeaf2; font-size: 16px; }
.galaxy-root .review-action:disabled { color: #a9b8c8; background-color: #101b29; }
.galaxy-root .review-action:focus { border-width: 2px; border-color: #9fd8fb; }
.galaxy-root .primary-action { background-color: #efb16b; color: #050a10; }
.galaxy-title { font-size: 28px; color: #efb16b; -unity-font-style: bold; }
.galaxy-subtitle { color: #a9b8c8; font-size: 15px; margin-bottom: 10px; white-space: normal; }
.galaxy-controls { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; }
.galaxy-controls .review-action { margin-right: 8px; margin-bottom: 6px; min-width: 90px; min-height: 44px; }
.galaxy-controls TextField { width: 230px; margin-right: 12px; }
.galaxy-controls TextField > Label { min-width: 42px; }
.galaxy-controls PopupField { min-width: 145px; margin-right: 12px; }
.galaxy-controls .unity-base-popup-field { min-width: 145px; margin-right: 12px; }
.galaxy-controls .unity-base-field__label { min-width: 45px; }
.galaxy-controls .unity-base-field__input { min-height: 40px; }
.galaxy-status { white-space: normal; color: #9fd8fb; margin-top: 3px; margin-bottom: 10px; flex-shrink: 0; }
.galaxy-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.galaxy-map-column { flex-grow: 1; min-width: 0; min-height: 0; margin-right: 16px; }
.galaxy-map {
    flex-grow: 1; min-height: 100px; overflow: hidden; background-color: #08121e;
    border-width: 1px; border-color: #607993; border-radius: 12px;
}
.galaxy-map:focus { border-color: #9fd8fb; }
.galaxy-map-tools { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-top: 8px; }
.galaxy-map-tools .review-action { min-width: 56px; min-height: 44px; margin-right: 6px; }
.galaxy-hint { font-size: 14px; color: #a9b8c8; white-space: normal; margin-top: 4px; flex-shrink: 0; }
.galaxy-inspector { width: 320px; min-width: 320px; flex-shrink: 0; background-color: #101b29; border-radius: 12px; padding: 14px; }
.galaxy-inspector Label { white-space: normal; margin-bottom: 8px; }
.galaxy-inspector .review-action { min-height: 44px; white-space: normal; margin-bottom: 6px; }
.galaxy-inspector-heading { font-size: 22px; color: #efb16b; margin-top: 8px; }
.galaxy-inspector-id { color: #a9b8c8; font-size: 13px; }
.galaxy-star {
    position: absolute; width: 28px; height: 28px; min-width: 28px; min-height: 28px;
    padding: 0; margin: 0; font-size: 12px; color: #d5e6f2; -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0); border-width: 2px; border-color: rgba(0,0,0,0); border-radius: 14px;
}
.galaxy-star:hover, .galaxy-star:focus { border-color: #9fd8fb; background-color: rgba(159,216,251,0.08); }
.galaxy-star-selected { border-color: #efb16b; color: #efb16b; }
.galaxy-system-label { position: absolute; font-size: 15px; color: #a9b8c8; white-space: normal; }
.galaxy-candidate-label { color: #b9ace6; }
.galaxy-candidate-target {
    position: absolute; width: 22px; height: 22px; min-width: 22px; min-height: 22px;
    margin: 0; padding: 0; color: #b9ace6; font-size: 22px; -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0); border-width: 1px; border-color: rgba(0,0,0,0);
}
.galaxy-candidate-target:hover, .galaxy-candidate-target:focus { border-color: #9fd8fb; }
.galaxy-compact { padding: 16px; font-size: 16px; }
.galaxy-compact .galaxy-inspector { width: 280px; min-width: 280px; }
.galaxy-compact .galaxy-title { font-size: 24px; }
.galaxy-compact .galaxy-map-column { margin-right: 12px; }
.galaxy-wide { padding: 28px; }
.galaxy-wide .galaxy-inspector { width: 360px; min-width: 360px; }
